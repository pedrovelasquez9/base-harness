{
  "name": "base-harness",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Harness de IA minimo y fiable, agnostico de proveedor (Anthropic u Ollama).",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"tests/integration/quality-loop.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "openai": "^7.25.0"
  }
}
